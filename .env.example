NODE_ENV=development
PORT=5000
# Public URL of the deployed app (no trailing slash). Used for OAuth callbacks + CORS.
BASE_URL=http://localhost:5000
# Extra allowed browser origins, comma separated (optional)
CLIENT_ORIGIN=

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/security_gateway

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh_different

BCRYPT_ROUNDS=12

# Cookie Secure flag stays ON. Only set to false for plain-http local testing in Postman.
COOKIE_SECURE=true

# Creates the 3 demo accounts (SuperAdmin/Manager/Employee) on startup
SEED_TEST_USERS=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
